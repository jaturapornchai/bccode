# Build artifacts
frontend/bcaiaccount/build/
frontend/bcaiaccount/.dart_tool/
frontend/bclms/build/
frontend/bclms/.dart_tool/
frontend/*/.flutter-plugins
frontend/*/.flutter-plugins-dependencies

# Dependencies
backend/vendor/
**/node_modules/

# Generated files
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart

# Lock files
**/pubspec.lock
**/go.sum

# IDE
.idea/
.vscode/
*.iml

# Binary / Media
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.ico
**/*.svg
**/*.ttf
**/*.otf
**/*.woff
**/*.woff2

# Secrets / Config
**/bootstrap.json
**/*.pem
**/*.cert
**/*.key

# Misc
**/coverage/
**/dist/
**/.DS_Store
**/Thumbs.db

# Claude worktrees (duplicate sources — wastes Glob/Grep)
.claude/worktrees/
**/.claude/worktrees/

# Long-term scripts/prompts (rarely loaded as context)
backend/scripts/
prompts/api_requests/

# Migrations (auto-generated, don't bloat search)
backend/migrations/
backend/internal/**/migrations/

{
  "mcpServers": {
    "mongodb": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server"
      ],
      "env": {}
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-docker"
      ],
      "env": {}
    },
    "codebase-memory-mcp": {
      "command": "C:/Users/jatur/AppData/Local/Programs/codebase-memory-mcp/codebase-memory-mcp.exe",
      "args": []
    },
    "openrouter": {
      "type": "http",
      "url": "https://mcp.openrouter.ai/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--allow-unrestricted-file-access"
      ],
      "env": {}
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": {}
    }
  }
}
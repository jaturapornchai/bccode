# 💰 Coupon Calculation API Testing
# ====================================
# ทดสอบ API สำหรับคำนวนส่วนลดจากคูปอง

@baseUrl = http://localhost:8080
@token = Bearer YOUR_AUTH_TOKEN_HERE

# ==========================================================
# 🧮 BASIC CALCULATION TESTS
# ==========================================================

### 1. คำนวนคูปองลดตามมูลค่า (Value Discount)
POST {{baseUrl}}/coupon/calculate
Authorization: {{token}}
Content-Type: application/json

{
  "order_amount": 1000.00,
  "coupons": [
    {
      "coupon_code": "VALUE100",
      "use_amount": 100.00
    }
  ],
  "customer_id": "CUST001"
}

### Expected Response:
# {
#   "success": true,
#   "total_discount": 100.00,
#   "total_cash_voucher": 0.00,
#   "final_amount": 900.00,
#   "coupon_results": [
#     {
#       "coupon_code": "VALUE100",
#       "coupon_type": 0,
#       "coupon_type_name": "ลดตามมูลค่า",
#       "discount_amount": 100.00,
#       "cash_voucher_amount": 0.00,
#       "used_amount": 100.00,
#       "remaining_value": 0.00,
#       "applied": true,
#       "message": "คำนวนสำเร็จ"
#     }
#   ]
# }

###


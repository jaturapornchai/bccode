# ==========================================================
# 🔗 MULTIPLE COUPONS CALCULATION (CASCADING)
# ==========================================================

###

### 4. คำนวนหลายคูปองรวมกัน (Mixed Types)
POST {{baseUrl}}/coupon/calculate
Authorization: {{token}}
Content-Type: application/json

{
  "order_amount": 2000.00,
  "coupons": [
    {
      "coupon_code": "VALUE100",
      "use_amount": 100.00
    },
    {
      "coupon_code": "PERCENT10",
      "use_amount": 10.00
    },
    {
      "coupon_code": "CASH200",
      "use_amount": 200.00
    }
  ],
  "customer_id": "CUST001"
}

### Expected Cascading Logic:
# Step 1: Original Amount = 2000.00
# Step 2: Apply Value Discount (-100.00) = 1900.00  
# Step 3: Apply Percentage (10% of 1900.00 = -190.00) = 1710.00
# Step 4: Apply Cash Voucher (-200.00) = 1510.00
# Final Amount = 1510.00

###


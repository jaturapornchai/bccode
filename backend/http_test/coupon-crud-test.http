###

### Update Coupon Information
PUT {{baseUrl}}/coupon/{{couponId}}
Authorization: {{token}}
Content-Type: application/json

{
  "couponcode": "SAVE100",
  "names": [
    {
      "code": "th",
      "name": "คูปองส่วนลด 100 บาท (แก้ไข)",
      "isauto": false,
      "isdelete": false
    },
    {
      "code": "en",
      "name": "100 Baht Discount Coupon (Updated)",
      "isauto": false,
      "isdelete": false
    }
  ],
  "couponvalue": 100.00,
  "remainingvalue": 75.00,
  "issueddate": "2025-06-20T00:00:00Z",
  "expirydate": "2025-12-31T23:59:59Z",
  "coupontype": 0,
  "customercode": "{{customerId}}",
  "remark": "คูปองทดสอบระบบ (ใช้ไปแล้ว 25 บาท)",
  "status": 0,
  "isonetimeuse": false
}


# 🎫 Basic Coupon CRUD Operations
# =================================
# ทดสอบการจัดการคูปองพื้นฐาน

@baseUrl = http://localhost:8080
@token = Bearer YOUR_AUTH_TOKEN_HERE
@customerId = CUST001
@couponId = YOUR_COUPON_ID_HERE

# ==========================================================
# 📋 SYSTEM INFORMATION
# ==========================================================

### Get Coupon Types
GET {{baseUrl}}/coupon-type
Authorization: {{token}}
Content-Type: application/json

### Expected Response:
# [
#   {
#     "id": 0,
#     "name": "ลดตามมูลค่า",
#     "description": "ส่วนลดตามจำนวนเงิน"
#   },
#   {
#     "id": 1,
#     "name": "ลดตามเปอร์เซ็นต์",
#     "description": "ส่วนลดตามเปอร์เซ็นต์"
#   },
#   {
#     "id": 2,
#     "name": "คูปองแทนเงินสด",
#     "description": "ใช้แทนเงินสด"
#   }
# ]

###

### Get Coupon Status
GET {{baseUrl}}/coupon-status
Authorization: {{token}}
Content-Type: application/json

### Expected Response:
# [
#   {
#     "id": 0,
#     "name": "ปกติ",
#     "description": "คูปองใช้งานได้"
#   },
#   {
#     "id": 1,
#     "name": "ยกเลิก",
#     "description": "คูปองถูกยกเลิก"
#   }
# ]

# ==========================================================
# ➕ CREATE COUPON
# ==========================================================

###

### Create Value Discount Coupon (ลดตามมูลค่า)
POST {{baseUrl}}/coupon
Authorization: {{token}}
Content-Type: application/json

{
  "couponcode": "SAVE100",
  "names": [
    {
      "code": "th",
      "name": "คูปองส่วนลด 100 บาท",
      "isauto": false,
      "isdelete": false
    },
    {
      "code": "en",
      "name": "100 Baht Discount Coupon",
      "isauto": false,
      "isdelete": false
    }
  ],
  "couponvalue": 100.00,
  "remainingvalue": 100.00,
  "issueddate": "2025-06-20T00:00:00Z",
  "expirydate": "2025-12-31T23:59:59Z",
  "coupontype": 0,
  "customercode": "{{customerId}}",
  "remark": "คูปองทดสอบระบบ",
  "status": 0,
  "isonetimeuse": false
}

### Expected Response:
# {
#   "success": true,
#   "message": "Coupon created successfully",
#   "data": {
#     "id": "generated-coupon-id"
#   }
# }

###


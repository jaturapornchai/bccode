  "couponcode": "",
  "names": [],
  "couponvalue": -10.00,
  "remainingvalue": -5.00,
  "issueddate": "invalid-date",
  "expirydate": "2020-01-01T00:00:00Z",
  "coupontype": 999,
  "customercode": "",
  "remark": "Invalid coupon test",
  "status": 0,
  "isonetimeuse": false
}


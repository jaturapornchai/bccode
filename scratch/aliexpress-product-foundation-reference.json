      "sync_price": "Value used by aliexpress.solution.batch.product.price.update",
      "cost": "Internal BC cost; AliExpress seller APIs do not provide true merchant cost"
    },
    "package": {
      "packageweight": "AliExpress weight, packageweight, gross_weight",

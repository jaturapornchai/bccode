  "source_evidence_summary": {
    "shopee": "Shopee product structures commonly split item media, attributes, two-tier variations, and per-model SKU price/stock. The official portal is login/JS heavy, so the BC model keeps this mapping conservative and source-specific only in internal profiles.",
    "lazada": "Lazada documents product APIs around category tree, category attributes, product create/update, item images, attributes, SKUs, sale properties, package dimensions, price, and quantity.",
    "tiktok": "TikTok Shop documents products, product attributes, sales attributes, images, inventory, price, review status, and SKU limits for product create/edit flows.",
    "product_operation": "AliExpress product workflows include category mapping, brand permission, freight templates, size chart templates, product post/edit, price update, stock update, online/offline, and product query.",
    "category_tree": "Category tree returns children_category_id, is_leaf_category, level, and multi_language_names; product category used for posting must be a leaf category.",
    "product_post": "Product post supports language, product_unit, category_id, attributes, SKU attributes, inventory, price, discount_price, sku_code, EAN/GTIN, package weight/dimensions, inventory deduction strategy, freight template, and country prices.",
    "sku_attribute_query": "SKU attribute query returns category-specific SKU attributes, allowed SKU values, customized name/picture flags, and common attributes with required flags.",
    "schema_api": "Schema get returns a category schema string; schema full update sends category_id, multilingual title/description, image_url_list, category_attributes, sku_info_list, package and shipping fields, and aliexpress_product_id.",
    "product_info": "Product info returns product-level price, currency, package dimensions, images, status, SKU list, SKU code, stock, SKU price/discount price, EAN/GTIN, and multi-country price configuration.",
    "order_info": "Order detail exposes child line fields such as product_id, sku_code, product_count, product_price, product image, product name, snapshot URL, product_standard, order status, and logistics fields.",
    "price_stock_update": "Batch inventory and batch price APIs update up to 20 products per call, with per-product SKU update lists keyed by sku_code."
  },

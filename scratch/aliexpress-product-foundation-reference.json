    "shopee": {
      "product_media_keys": ["image.image_id_list", "description_info", "video_upload_id"],
      "specification_keys": ["attribute_list", "tier_variation", "model_list"],
      "sku_keys": ["model_sku", "tier_index", "normal_stock", "original_price"],
      "notes": "Shopee generally separates item images, item attributes, two-tier variations, and model/SKU price-stock rows."
    },
    "lazada": {
      "product_media_keys": ["Images.Image", "Skus.Sku.Images.Image", "description", "short_description"],
      "specification_keys": ["PrimaryCategory", "Attributes", "SaleProp"],
      "sku_keys": ["SellerSku", "ShopSku", "price", "quantity", "packageweight", "packagelength", "packagewidth", "packageheight"],
      "notes": "Lazada product create/update uses category attributes first; leaf category and variant attributes drive valid SKU sale properties."
    },
    "tiktok": {
      "product_media_keys": ["main_images", "description", "skus.sales_attributes.sku_img", "certifications.files", "size_chart.image"],
      "specification_keys": ["product_attributes", "sales_attributes"],
      "sku_keys": ["sellersku", "price", "inventory", "identifier_code", "packageweight", "package_dimensions"],
      "notes": "TikTok distinguishes product attributes from sales attributes; sales attributes are SKU variant attributes such as color and size."
    },
    "aliexpress": {
      "product_media_keys": ["main_image_urls_list", "image_url_list", "detail_source_list.mobile_detail", "sku_info_list.sku_attributes_list.sku_image_url"],
      "specification_keys": ["attribute_list", "category_attributes", "supporting_common_attribute_list", "supporting_sku_attribute_list"],
      "sku_keys": ["sku_code", "inventory", "price", "discount_price", "ean_code", "bar_code", "weight", "packagelength", "packagewidth", "packageheight"],
      "notes": "AliExpress category/attribute APIs are the most detailed; store both external ids and display names for reliable round-trip mapping."
